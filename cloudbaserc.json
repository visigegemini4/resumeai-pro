{
  "$schema": "https://framework.cloudbase.net/framework-schema.json",
  "envId": "resumeai-pro-d5gql4vpq34e14857",
  "version": "2.0",
  "framework": {
    "name": "resumeai-pro",
    "plugins": {
      "frontend": {
        "use": "@cloudbase/framework-plugin-website",
        "inputs": {
          "projectPath": "frontend",
          "installCommand": "npm install --prefer-offline --no-audit --progress=false",
          "buildCommand": "npm run build",
          "outputPath": "dist",
          "cloudPath": "/",
          "index": "index.html",
          "error": {
            "404": "index.html"
          }
        }
      },
      "api": {
        "use": "@cloudbase/framework-plugin-function",
        "inputs": {
          "name": "resumeai-api",
          "projectRoot": "cloudbase",
          "functionRoot": ".",
          "buildCommand": "npm install --prefer-offline --no-audit --progress=false && npm run build",
          "handler": "index.main",
          "runtime": "Nodejs18.15",
          "timeout": 90,
          "installDependency": false,
          "memory": 512
        }
      }
    }
  }
}
