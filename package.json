{
  "name": "resumeai-pro-5",
  "private": true,
  "version": "5.0.0",
  "workspaces": ["frontend", "backend", "cloudbase"],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm start --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:cloudbase": "npm run build --workspace=cloudbase",
    "typecheck:frontend": "npx -w frontend tsc --noEmit",
    "typecheck:backend": "npx -w backend tsc --noEmit",
    "typecheck:cloudbase": "npm run typecheck --workspace=cloudbase"
  }
}
